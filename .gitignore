# deps / build
node_modules/
dist/
.wrangler/
__pycache__/
*.pyc

# secrets
.env
.env.*
.dev.vars

# large raw downloads (station_database等の再取得可能データ)
data/raw/

# 各校トップページのキャッシュ（7MB超・228ファイル）。部活動ページURLを見つける
# ためだけの中間物で、scripts/build_school_sites.py がいつでも取り直せる。
# 台帳そのもの（data/seed/school_sites.csv）と一次ソースの list.xlsx は追跡する。
data/fetched/tops/

# アクセス・校風ページのキャッシュ（fetch_school_access.py / fetch_school_spirit.py で再取得可能）
data/fetched/access/
data/fetched/spirit/
# 決め打ちURLで取れなかった19校ぶん（fetch_missing_spirit.py で再取得可能）。
# 抽出済みの data/seed/school_spirit_extra.csv のみ追跡する
data/fetched/spirit3/

# 都高体連の成績PDF（再取得可能・11MB）。抽出済みCSVのみ追跡する
data/fetched/kotairen/*.pdf
data/fetched/clubs/
data/fetched/uniforms/*.html

# 高野連の試合結果HTML。出場選手の氏名が載っているため追跡しない
# （parse_hbf_results.py が学校名・ラウンド・スコアだけを取り出す）。
# fetch_hbf_results.py でいつでも取り直せる。
data/fetched/hbf/
data/fetched/suisou/*.pdf
data/fetched/ifac/*.pdf

# 演劇都大会の結果ページ。build_engeki_results.py でいつでも取り直せる。
data/fetched/engeki/

# ダンス選手権の結果PDF（10本・3MB）。fetch_dance_results.py で取り直せる。
# 氏名は載っていないが、抽出済みCSVのみ追跡するのは他の連盟と同じ扱い。
data/fetched/dance/
